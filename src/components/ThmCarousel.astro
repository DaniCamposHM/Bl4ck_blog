---
import thm from '../data/thmProfile.json';

// Expand mock data carousel demo when only 1 badge -> duplicate with placeholder for visual test
// Real data will be N badges; carousel handles 1..N
const allBadges = thm.badges || [];

// For demo if only 1 badge, add 2 more placeholder to show carousel behavior (will be replaced when you add more)
const demoExtra = allBadges.length === 1 ? [
  { name: 'Pre Security', slug: 'presecurity', url: 'https://tryhackme.com/p/Danihm', publicUrl: 'https://tryhackme.com/p/Danihm', issuer: 'TryHackMe', placeholder: true },
  { name: 'Intro to Cyber', slug: 'intro-cyber', url: 'https://tryhackme.com/p/Danihm', publicUrl: 'https://tryhackme.com/p/Danihm', issuer: 'TryHackMe', placeholder: true },
] : [];

const badges = [...allBadges, ...demoExtra];
---

<div class="relative group/carousel">
  <p class="text-[11px] font-mono tracking-widest text-[#636366] flex items-center gap-2">
    GALERÍA DE BADGES
    <span class="text-[10px] text-[#A1A1AA] normal-case tracking-normal font-sans">— desliza o usa flechas</span>
    <span class="ml-auto text-[11px] text-[#A1A1AA]">{badges.length} badges</span>
  </p>

  <div class="relative mt-3">
    <!-- Buttons -->
    <button id="thm-prev" aria-label="Anterior" class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-2 z-10 hidden sm:flex h-8 w-8 items-center justify-center rounded-full border border-[#2C2C2E] bg-[#030303] text-[#A1A1AA] hover:border-[#DF2531]/40 hover:text-white transition opacity-0 group-hover/carousel:opacity-100">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <button id="thm-next" aria-label="Siguiente" class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-2 z-10 hidden sm:flex h-8 w-8 items-center justify-center rounded-full border border-[#2C2C2E] bg-[#030303] text-[#A1A1AA] hover:border-[#DF2531]/40 hover:text-white transition opacity-0 group-hover/carousel:opacity-100">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
    </button>

    <!-- Scroll container -->
    <div id="thm-track" class="flex gap-3 overflow-x-auto scroll-smooth snap-x snap-mandatory pb-2 -mx-1 px-1 scrollbar-thin" style="scrollbar-width: thin; scrollbar-color: #2C2C2E transparent;">
      {badges.map((b) => (
        <a
          href={b.publicUrl || b.url}
          target="_blank"
          rel="noopener noreferrer"
          class={`snap-start shrink-0 w-[160px] sm:w-[180px] rounded-xl border bg-[#030303] p-4 flex flex-col items-center text-center transition hover:border-[#DF2531]/40 hover:bg-[#111113] group ${b.placeholder ? 'border-dashed border-[#2C2C2E] opacity-60' : 'border-[#2C2C2E]'}`}
        >
          <div class={`h-16 w-16 rounded-full flex items-center justify-center border ${b.placeholder ? 'border-dashed border-[#2C2C2E] bg-[#111113]' : 'border-[#2C2C2E] bg-[#111113] group-hover:border-[#DF2531]/30'}`}>
            {b.image ? (
              <img src={b.image} alt={b.name} width="48" height="48" loading="lazy" class="h-12 w-12 object-contain" />
            ) : (
              <span class="text-[10px] font-mono font-bold tracking-widest text-[#DF2531]">{b.name.slice(0,3).toUpperCase()}</span>
            )}
          </div>
          <p class="mt-3 text-xs font-semibold leading-tight text-white line-clamp-2">{b.name}</p>
          <p class="mt-1 text-[11px] text-[#636366]">{b.issuer || 'TryHackMe'}</p>
          {b.placeholder && <span class="mt-2 rounded-full bg-[#2C2C2E] px-2 py-0.5 text-[9px] tracking-widest text-[#A1A1AA]">PRÓXIMO</span>}
          {!b.placeholder && <span class="mt-2 inline-flex items-center gap-1 text-[10px] text-[#DF2531] opacity-0 group-hover:opacity-100 transition">Ver <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7"/><path d="M8 7h9v9"/></svg></span>}
        </a>
      ))}
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const track = document.getElementById('thm-track');
    const prev = document.getElementById('thm-prev');
    const next = document.getElementById('thm-next');
    if (!track || !prev || !next) return;
    const step = 190;
    prev.addEventListener('click', () => track.scrollBy({ left: -step, behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step, behavior: 'smooth' }));
    // Touch swipe hint: hide buttons on mobile handled by CSS
    // Re-run on view transitions
    document.addEventListener('astro:page-load', () => {
      const t = document.getElementById('thm-track');
      if (t) {
        const p = document.getElementById('thm-prev');
        const n = document.getElementById('thm-next');
        if (p && n) {
          p.onclick = () => t.scrollBy({ left: -step, behavior: 'smooth' });
          n.onclick = () => t.scrollBy({ left: step, behavior: 'smooth' });
        }
      }
    });
  })();
</script>

<style>
  #thm-track::-webkit-scrollbar { height: 6px; }
  #thm-track::-webkit-scrollbar-thumb { background: #2C2C2E; border-radius: 9999px; }
  #thm-track::-webkit-scrollbar-track { background: transparent; }
</style>
