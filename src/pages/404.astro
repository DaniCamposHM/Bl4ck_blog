---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="404 — BL4CKJACKHM" description="Página no encontrada.">
  <section class="mx-auto max-w-2xl px-4 sm:px-6 py-16 text-center">
    <p data-i18n="notFound.error" class="font-mono text-xs tracking-widest text-[#DF2531]">ERROR 404</p>
    <h1 data-i18n="notFound.title" class="mt-3 text-3xl font-bold text-white">Página no encontrada</h1>
    <p data-i18n="notFound.desc" class="mt-3 text-sm leading-relaxed text-[#A1A1AA]">La ruta que buscas no existe o fue movida. Prueba el buscador o vuelve al inicio.</p>
    <div class="mt-6 flex justify-center gap-3">
      <a href="/" data-i18n="notFound.home" class="rounded-md bg-[#7FA6A0] px-5 py-2.5 text-sm font-semibold text-[#030303]">Inicio</a>
      <a href="/search" data-i18n="notFound.search" class="rounded-md border border-[#2C2C2E] bg-[#111113] px-5 py-2.5 text-sm text-white">Buscar</a>
    </div>
  </section>
</MainLayout>
