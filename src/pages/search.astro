  <section class="mx-auto max-w-3xl px-4 sm:px-6 py-10">
    <h1 data-i18n="searchPage.title" class="text-2xl font-bold tracking-tight text-white">Buscar</h1>
    <p data-i18n="searchPage.desc" class="mt-2 text-sm text-[#A1A1AA]">Índice generado en build. Busca por título, tags, colección o descripción.</p>
    <div class="mt-6">
      <Search client:load />
    </div>
  </section>
</MainLayout>
