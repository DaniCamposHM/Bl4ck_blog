---
import MainLayout from './MainLayout.astro';
import Tag from '../components/Tag.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  collection?: string;
  heroImage?: string;
}
const { title, description, date, tags = [], collection, heroImage } = Astro.props;
const lang = 'es';
const formatted = new Date(date).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });
---

<MainLayout title={title} description={description} image={heroImage}>
  <article class="mx-auto max-w-3xl px-4 sm:px-6 py-10"> {/* Negro 50-60% fondo articulo */}
    <header class="mb-8">
      {collection && (
        <span class="inline-flex rounded bg-[#7FA6A0] px-2.5 py-1 text-xs font-mono font-bold tracking-widest text-[#030303] uppercase">
          {collection}
        </span> /* Teal 5-10% categoria sobre Negro */
      )}
      <h1 class="mt-4 text-3xl sm:text-4xl font-bold tracking-tight text-white leading-tight">{title}</h1> {/* Blanco 10-15% */}
      <p class="mt-3 text-base leading-relaxed text-[#A1A1AA]">{description}</p> {/* Gris 5-10% */}
      <div class="mt-4 flex flex-wrap items-center gap-3 text-xs text-[#A1A1AA]"> {/* Gris metadata */}
        <time datetime={new Date(date).toISOString()} class="font-mono">{formatted}</time>
        {tags.length > 0 && <span>·</span>}
        <div class="flex flex-wrap gap-1.5">
          {tags.map((t) => <Tag tag={t} href={`/search?q=${t}`} />)} {/* Teal por defecto, Rojo 2-5% si CVE/vuln */}
        </div>
      </div>
    </header>

    {heroImage && (
      <img src={heroImage} alt={title} class="mb-8 w-full rounded-xl border border-[#2C2C2E] object-cover" /> /* Charcoal borde */
    )}

    <div class="prose max-w-none">
      <slot />
    </div>

    <hr class="my-10 border-[#2C2C2E]" />
    <a href="javascript:history.back()" data-i18n="article.back" class="text-sm text-[#7FA6A0] hover:underline">← Volver</a>
  </article>
</MainLayout>
